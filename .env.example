# Ainzigartig — Public Snapshot Environment Configuration
# Copy to .env for local runtime execution

# AI Model Provider (OpenAI Chat Completions API or Vercel AI Gateway)
OPENAI_API_KEY=your_openai_api_key_here
# AI_GATEWAY_API_KEY=your_gateway_key_here
# VERCEL_OIDC_TOKEN=your_oidc_token_here

# Website Scraper Service (FastAPI service in scraper/)
SCRAPER_URL=http://localhost:8501

# Contact Form Delivery (Resend)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=contact@example.com
CONTACT_FROM="Ainzigartig Website <onboarding@resend.dev>"

# Server Runtime Configuration
PORT=3010
CHAT_ENABLED=true
